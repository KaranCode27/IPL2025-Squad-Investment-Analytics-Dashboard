{
  "name": "IPL 2025 Dark Theme",
  "dataColors": [
    "#FFD700",
    "#007BFF",
    "#FF4D4D",
    "#8A2BE2",
    "#FF8C00",
    "#20B2AA",
    "#00FF00",
    "#FF1493",
    "#ADFF2F",
    "#FFD700"
  ],
  "background": "#1A1D20",
  "foreground": "#FFFFFF",
  "tableAccent": "#FFD700",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#2D3238" } },
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#495057" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 75,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14,
            "alignment": "Left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1A1D20" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFD700" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#ADB5BD" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridColor": { "solid": { "color": "#495057" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1A1D20" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#E9ECEF" } },
            "backColor": { "solid": { "color": "#2D3238" } }
          }
        ]
      }
    }
  }
}
